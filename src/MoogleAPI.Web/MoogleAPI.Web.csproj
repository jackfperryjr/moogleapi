<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>60dda6ea-7514-41f2-ab1b-92b1b91d1fb3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- WikiClient's parsers are internal; the parsing tests reach them directly. -->
    <InternalsVisibleTo Include="MoogleAPI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="8.1.0" />
    <PackageReference Include="FastEndpoints.Security" Version="8.1.0" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.1.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.5.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.7" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.6" />
    <!-- Dashboard image uploads land in R2, which speaks the S3 API — versions pinned to the
         scraper's so the two write identical objects to the same bucket. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.101.6" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- The two authenticated pages and the stylesheet and script each one loads. They live outside
       wwwroot, so nothing copies them to the output directory by convention and Program.cs serves
       each by an explicit route. -->
  <ItemGroup>
    <Content Include="Dashboard\index.html;Dashboard\app.css;Dashboard\app.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Stats\index.html;Stats\app.css;Stats\app.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
